# Safe placeholders only. Copy values to your deployment environment.
DJANGO_SECRET_KEY=replace-with-a-generated-secret-key
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=your-domain.example
DJANGO_CSRF_TRUSTED_ORIGINS=https://your-domain.example
DJANGO_TIME_ZONE=Asia/Shanghai
DJANGO_HSTS_SECONDS=31536000
# Enable only behind a proxy you control that strips untrusted forwarding headers.
DJANGO_TRUST_PROXY=false
DB_ENGINE=sqlite
# DB_NAME=/absolute/private/path/to/db.sqlite3
# Optional MySQL: DB_ENGINE=mysql; configure DB_NAME, DB_USER, DB_PASSWORD, DB_HOST, DB_PORT.
# Optional SMTP; notifications are currently deferred. Never commit actual credentials.
# SMTP_HOST=your-smtp-host.example
# SMTP_PORT=587
# SMTP_USER=your-smtp-user
# SMTP_PASSWORD=replace-with-private-smtp-password
