# Copy to .env and replace the placeholder with a generated secret.
DJANGO_SECRET_KEY=replace-with-a-generated-secret-key
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_TIME_ZONE=Asia/Shanghai

# SQLite requires no database server. DB_NAME is optional for SQLite.
DB_ENGINE=sqlite
# DB_NAME=db.sqlite3

# Optional MySQL: install mysqlclient, set DB_ENGINE=mysql, and fill these in.
# DB_NAME=your_database_name
# DB_USER=your_database_user
# DB_PASSWORD=your_database_password
# DB_HOST=127.0.0.1
# DB_PORT=3306

# Optional local fictional demo password; omitted means randomly generated.
# DEMO_PASSWORD=choose-a-strong-development-only-password
